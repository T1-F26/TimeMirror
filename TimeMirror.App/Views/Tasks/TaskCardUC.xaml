<UserControl x:Class="TimeMirror.App.Views.Tasks.TaskCardUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Issue #53
         Reusable task card: Title, Description, Due date, Completed.
         Used by New Task (#50), View Task (#68) and Edit Task (#45).
         Binds to the parent ViewModel (DataContext is inherited).
         When the ViewModel's IsViewMode is true, the fields are read-only (#54).
         #17: Completed checkbox (TaskItem.IsCompleted). -->

    <UserControl.Resources>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsViewMode}" Value="True">
                    <Setter Property="IsReadOnly" Value="True"/>
                    <Setter Property="Background" Value="#F3F3F3"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,4,0,16"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsViewMode}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsViewMode}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <StackPanel>

        <TextBlock Text="Title *"/>
        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Description *"/>
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Height="80"/>

        <TextBlock Text="Due date *"/>
        <DatePicker SelectedDate="{Binding DueDate}"
                    Width="200"
                    HorizontalAlignment="Left"/>

        <CheckBox Content="Completed"
                  IsChecked="{Binding IsCompleted}"
                  Margin="0,0,0,16"/>

    </StackPanel>
</UserControl>