<UserControl x:Class="TimeMirror.App.Views.Tasks.NewTaskViewUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Issue #50 - Vincent
         Form to create a new task. DataContext is NewTaskViewModel (#49),
         wired up by Dev in App.xaml (#52). -->
    <StackPanel MaxWidth="500" HorizontalAlignment="Left">

        <TextBlock Text="New Task"
                   FontSize="26"
                   Margin="0,0,0,15"/>

        <TextBlock Text="Title *"/>
        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                 Padding="4"
                 Margin="0,4,0,12"/>

        <TextBlock Text="Description"/>
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Height="80"
                 Padding="4"
                 Margin="0,4,0,12"/>

        <TextBlock Text="Due date *"/>
        <DatePicker SelectedDate="{Binding DueDate}"
                    Width="200"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,16"/>

        <StackPanel Orientation="Horizontal">
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    Width="100"
                    Padding="4"
                    Margin="0,0,10,0"/>
            <Button Content="Clear"
                    Command="{Binding ClearCommand}"
                    Width="100"
                    Padding="4"/>
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="#C0392B"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"/>

        <TextBlock Text="{Binding SuccessMessage}"
                   Foreground="#2E7D32"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"/>
    </StackPanel>
</UserControl>