<UserControl x:Class="TimeMirror.App.Views.Tasks.TaskDetailsViewUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tasks="clr-namespace:TimeMirror.App.Views.Tasks">

    <!-- View Task (#68) - Vincent
         Shows a saved task in the reusable TaskCardUC (#53), read-only.
         DataContext is TaskViewModel (#54/#55). -->
    <StackPanel MaxWidth="500" HorizontalAlignment="Left">

        <TextBlock Text="Task Details"
                   FontSize="26"
                   Margin="0,0,0,15"/>

        <tasks:TaskCardUC/>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="#C0392B"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <Button Content="Back to Agenda"
                Command="{Binding BackCommand}"
                Width="140"
                Padding="4"
                HorizontalAlignment="Left"/>
    </StackPanel>
</UserControl>