<UserControl x:Class="TimeMirror.App.Views.Dashboard.DashboardViewUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- Dashboard button styling -->
        <Style x:Key="DashboardButton" TargetType="Button">
            <Setter Property="Background" Value="#273544"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dashboard card styling -->
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="#273544"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0BECC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style x:Key="EmptyMessage" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0BECC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="5,20"/>
        </Style>

        <!-- Reusable task template -->
        <DataTemplate x:Key="DashboardTaskTemplate">
            <Border Background="#233B55"
                    BorderBrush="#5599EF"
                    BorderThickness="3,0,0,0"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,8">

                <StackPanel>

                    <TextBlock Text="{Binding Title}"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding DueDate,
                               StringFormat='{}{0:MMM dd, yyyy - h:mm tt}'}"
                               Foreground="#B0BECC"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>

                    <TextBlock FontSize="11"
                               Margin="0,5,0,0">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Pending"/>
                                <Setter Property="Foreground" Value="#FBBF24"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}"
                                                 Value="True">
                                        <Setter Property="Text" Value="Completed"/>
                                        <Setter Property="Foreground" Value="#4ADE80"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>

                    </TextBlock>

                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Border Background="#111C28"
            CornerRadius="8"
            Padding="20">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- Dashboard header -->
                <Grid Margin="0,0,0,15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Dashboard"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <TextBlock Text="{Binding CurrentDate}"
                                   Foreground="#B0BECC"
                                   FontSize="13"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="Overview of your tasks and application usage."
                                   Foreground="#B0BECC"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Refresh"
                            Command="{Binding LoadDashboardCommand}"
                            VerticalAlignment="Top">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource DashboardButton}">

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}"
                                                 Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Content" Value="Loading..."/>
                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </Button.Style>

                    </Button>

                </Grid>

                <!-- Loading and error messages -->
                <TextBlock Text="Loading dashboard..."
                           Foreground="#93C5FD"
                           Margin="5,0,5,10">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>

                </TextBlock>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#F87171"
                           TextWrapping="Wrap"
                           Margin="5,0,5,10">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}"
                                             Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>

                </TextBlock>

                <!-- Daily summary cards -->
                <UniformGrid Columns="4"
                             Margin="0,0,0,5">

                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>

                            <TextBlock Text="Today's Tasks"
                                       Style="{StaticResource SummaryLabel}"/>

                            <TextBlock Text="{Binding TotalTaskCount}"
                                       Style="{StaticResource SummaryValue}"/>

                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>

                            <TextBlock Text="Completed"
                                       Style="{StaticResource SummaryLabel}"/>

                            <TextBlock Text="{Binding CompletedTaskCount}"
                                       Style="{StaticResource SummaryValue}"
                                       Foreground="#4ADE80"/>

                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>

                            <TextBlock Text="Pending"
                                       Style="{StaticResource SummaryLabel}"/>

                            <TextBlock Text="{Binding PendingTaskCount}"
                                       Style="{StaticResource SummaryValue}"
                                       Foreground="#FBBF24"/>

                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>

                            <TextBlock Text="Tracked Time Today"
                                       Style="{StaticResource SummaryLabel}"/>

                            <TextBlock Text="{Binding TotalTrackedTimeText}"
                                       Style="{StaticResource SummaryValue}"
                                       FontSize="22"
                                       Foreground="#93C5FD"
                                       TextWrapping="Wrap"/>

                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- Daily task completion -->
                <Border Style="{StaticResource DashboardCard}">

                    <StackPanel>

                        <DockPanel Margin="0,0,0,10">

                            <TextBlock Text="Daily Task Progress"
                                       Style="{StaticResource SectionHeading}"
                                       Margin="0"/>

                            <TextBlock Text="{Binding TaskCompletionPercentage,
                                       StringFormat='{}{0:0}%'}"
                                       Foreground="#4ADE80"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>

                        </DockPanel>

                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding TaskCompletionPercentage, Mode=OneWay}"
                                     Height="10"
                                     Foreground="#4ADE80"
                                     Background="#344455"
                                     BorderThickness="0"/>

                        <TextBlock Foreground="#B0BECC"
                                   FontSize="12"
                                   Margin="0,8,0,0">

                            <Run Text="{Binding CompletedTaskCount, Mode=OneWay}"/>
                            <Run Text=" of "/>
                            <Run Text="{Binding TotalTaskCount, Mode=OneWay}"/>
                            <Run Text=" tasks completed today"/>

                        </TextBlock>

                    </StackPanel>

                </Border>

                <!-- Today's tasks and upcoming tasks -->
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource DashboardCard}">

                        <StackPanel>

                            <TextBlock Text="Today's Tasks"
                                       Style="{StaticResource SectionHeading}"/>

                            <ItemsControl ItemsSource="{Binding TodaysTasks}"
                                          ItemTemplate="{StaticResource DashboardTaskTemplate}"/>

                            <TextBlock Text="No tasks scheduled for today.">

                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource EmptyMessage}">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTodaysTasks}"
                                                         Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>

                                    </Style>
                                </TextBlock.Style>

                            </TextBlock>

                        </StackPanel>

                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource DashboardCard}">

                        <StackPanel>

                            <TextBlock Text="Upcoming Tasks"
                                       Style="{StaticResource SectionHeading}"/>

                            <ItemsControl ItemsSource="{Binding UpcomingTasks}"
                                          ItemTemplate="{StaticResource DashboardTaskTemplate}"/>

                            <TextBlock Text="No upcoming tasks.">

                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource EmptyMessage}">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUpcomingTasks}"
                                                         Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>

                                    </Style>
                                </TextBlock.Style>

                            </TextBlock>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- Activity tracking summary -->
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource DashboardCard}">

                        <StackPanel>

                            <TextBlock Text="Recent Activity"
                                       Style="{StaticResource SectionHeading}"/>

                            <ItemsControl ItemsSource="{Binding RecentActivity}">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Border Background="#233B55"
                                                CornerRadius="4"
                                                Padding="10"
                                                Margin="0,0,0,8">

                                            <StackPanel>

                                                <TextBlock Text="{Binding ApplicationName}"
                                                           Foreground="White"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Text="{Binding StartTime,
                                                           StringFormat='Started: {0:MMM dd - h:mm tt}'}"
                                                           Foreground="#B0BECC"
                                                           FontSize="11"
                                                           Margin="0,4,0,0"/>

                                                <TextBlock Text="{Binding EndTime,
                                                           StringFormat='Ended: {0:MMM dd - h:mm tt}',
                                                           TargetNullValue='Session in progress'}"
                                                           Foreground="#B0BECC"
                                                           FontSize="11"
                                                           Margin="0,3,0,0"/>

                                            </StackPanel>

                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            <TextBlock Text="No recent activity recorded.">

                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource EmptyMessage}">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRecentActivity}"
                                                         Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>

                                    </Style>
                                </TextBlock.Style>

                            </TextBlock>

                        </StackPanel>

                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource DashboardCard}">

                        <StackPanel>

                            <TextBlock Text="Most Used App Today"
                                       Style="{StaticResource SectionHeading}"/>

                            <TextBlock Text="{Binding MostUsedApplication}"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,15,0,5"/>

                            <TextBlock Text="{Binding MostUsedApplicationDurationText}"
                                       Foreground="#93C5FD"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       Margin="0,5,0,15"/>

                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding MostUsedApplicationPercentage, Mode=OneWay}"
                                         Height="10"
                                         Foreground="#5599EF"
                                         Background="#344455"
                                         BorderThickness="0"/>

                            <TextBlock Text="{Binding MostUsedApplicationPercentage,
                                       StringFormat='{}{0:0}% of tracked time today'}"
                                       Foreground="#B0BECC"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Margin="0,10,0,5"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </StackPanel>

        </ScrollViewer>

    </Border>

</UserControl>