<UserControl x:Class="TimeMirror.App.Views.Agenda.AgendaViewUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="My Agenda"
                   FontSize="26"
                   Margin="0,0,0,15"/>

        <ComboBox SelectedValue="{Binding SelectedView}"
                  SelectedValuePath="Content"
                  Width="150"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,20">
            <ComboBoxItem Content="Day"/>
            <ComboBoxItem Content="Week"/>
            <ComboBoxItem Content="Month"/>
            <ComboBoxItem Content="Year"/>
        </ComboBox>

        <ListBox ItemsSource="{Binding VisibleTasks}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="8">
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="Bold"
                                   FontSize="16"/>

                        <TextBlock Text="{Binding DueDate,
                            StringFormat='Due: {0:MMM dd, yyyy h:mm tt}'}"
                                   Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>