<UserControl x:Class="TimeMirror.App.Views.Agenda.AgendaViewUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- Navigation button styling -->
        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Background" Value="#273544"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Border Background="#111C28"
            CornerRadius="8"
            Padding="20">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page heading -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,20">

                <TextBlock Text="Agenda"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="View your upcoming activities and commitments."
                           Foreground="#B0BECC"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <!-- Day, Week, Month and Year selectors -->
            <ListBox Grid.Row="1"
                     SelectedValue="{Binding SelectedView, Mode=TwoWay}"
                     SelectedValuePath="Content"
                     SelectionMode="Single"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalAlignment="Left"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Margin="0,0,0,15">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">

                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#273544"/>
                        <Setter Property="Width" Value="75"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Margin" Value="0,0,5,5"/>
                        <Setter Property="Cursor" Value="Hand"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">

                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4">

                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>

                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                        <Style.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#34495E"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Trigger>

                        </Style.Triggers>

                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBoxItem Content="Day"/>
                <ListBoxItem Content="Week"/>
                <ListBoxItem Content="Month"/>
                <ListBoxItem Content="Year"/>

            </ListBox>

            <!-- Date navigation -->
            <StackPanel Grid.Row="2"
                        Margin="0,0,0,15">

                <WrapPanel HorizontalAlignment="Center">

                    <Button Content="Previous"
                         Command="{Binding PreviousCommand}"
                         Style="{StaticResource NavigationButton}"/>

                    <TextBlock Text="{Binding SelectedDate,
                                      StringFormat='{}{0:ddd, MMM dd, yyyy}',
                                      FallbackValue='Date unavailable'}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="10,0,15,5"/>

                    <Button Content="Next"
                            Command="{Binding NextCommand}"
                            Style="{StaticResource NavigationButton}"/>

                    <Button Content="Today"
                            Command="{Binding TodayCommand}"
                            Style="{StaticResource NavigationButton}"/>

                </WrapPanel>

                <Separator Background="#344455"
                           Margin="0,10,0,0"/>

            </StackPanel>

            <!-- Agenda task list -->
            <Grid Grid.Row="3">

                <ListBox x:Name="AgendaTaskList"
                         ItemsSource="{Binding VisibleTasks}"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">

                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>

                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="85"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Task time and date -->
                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0">

                                    <TextBlock Text="{Binding DueDate,
                                                     StringFormat='{}{0:h:mm tt}'}"
                                               Foreground="White"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding DueDate,
                                                     StringFormat='{}{0:MMM dd, yyyy}'}"
                                               Foreground="#B0BECC"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>

                                </StackPanel>

                                <!-- Task card -->
                                <Border Grid.Column="1"
                                        Background="#233B55"
                                        BorderBrush="#5599EF"
                                        BorderThickness="4,0,0,0"
                                        CornerRadius="4"
                                        Padding="12">

                                    <StackPanel>

                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="#C1CDDA"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Margin="15">

                    <StackPanel.Style>
                        <Style TargetType="StackPanel">

                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding HasItems,
                                             ElementName=AgendaTaskList}"
                                             Value="False">

                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="No scheduled tasks"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="You have no tasks scheduled for this period."
                               Foreground="#B0BECC"
                               FontSize="14"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Border>

</UserControl>