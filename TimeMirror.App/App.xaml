<Application x:Class="TimeMirror.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TimeMirror.App.ViewModels"
             xmlns:agenda="clr-namespace:TimeMirror.App.Views.Agenda"
             xmlns:tasks="clr-namespace:TimeMirror.App.Views.Tasks"
             xmlns:activity="clr-namespace:TimeMirror.App.Views.ActivityTracking"
             xmlns:dashboard="clr-namespace:TimeMirror.App.Views.Dashboard"
             >

    <Application.Resources>

        <DataTemplate DataType="{x:Type vm:AgendaViewModel}">
            <agenda:AgendaViewUC/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NewTaskViewModel}">
            <tasks:NewTaskViewUC/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TaskViewModel}">
            <tasks:TaskDetailsViewUC/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AllTasksViewModel}">
            <tasks:AllTasksViewUC/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <dashboard:DashboardViewUC/>
        </DataTemplate>
        <!-- Activity Tracking -->
        <DataTemplate DataType="{x:Type vm:ActivityTrackingViewModel}">
            <activity:ActivityTrackingViewUC/>
        </DataTemplate>

    </Application.Resources>

</Application>
